# yazi: `y` opens the file manager and cds into the directory you quit in
y() {
  local tmp cwd
  tmp="$(mktemp -t yazi-cwd.XXXXXX)"
  yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
  rm -f -- "$tmp"
}

# atuin: searchable shell history on Ctrl+R (needs bash-preexec)
if command -v atuin >/dev/null && [[ -f /usr/share/bash-preexec/bash-preexec.sh ]]; then
  source /usr/share/bash-preexec/bash-preexec.sh
  eval "$(atuin init bash)"
fi

. "$HOME/.local/share/../bin/env"
